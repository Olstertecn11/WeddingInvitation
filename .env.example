# MySQL remote connection. Keep the real .env.local out of Git.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=true
DATABASE_CONNECT_TIMEOUT_MS=10000

# A long random value used to hash IP addresses.
RSVP_HASH_SALT=replace-with-a-long-random-secret

# Admin panel security. Use a long, unique value in production.
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Used only when running `npm run admin:create`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_DISPLAY_NAME=Administrador

# Optional. Useful if the site is deployed below a fixed public URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional SMTP settings for RSVP confirmation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Oliver & Analucía <invitaciones@example.com>"
SMTP_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=8000
